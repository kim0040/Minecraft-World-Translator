{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomiTranslate",
  "version": "0.1.0",
  "identifier": "app.pomitranslate.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PomiTranslate — World Translator for Minecraft",
        "width": 1180,
        "height": 800,
        "minWidth": 840,
        "minHeight": 620,
        "backgroundColor": "#f5f4f0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "externalBin": ["binaries/pomi-sidecar"],
    "icon": ["icons/icon.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
